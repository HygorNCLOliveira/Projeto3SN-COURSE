        <condition/>
        <description/>
        <field>course_date</field>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>ValidateUniqueCourseAndDate</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
    if (isLoading) {
        return; // Ignora o script quando o formulário está carregando
    }

    // Obtém os valores do Nome do Curso e Data
    var courseName = g_form.getValue('course'); // Campo de nome do curso
    var courseDate = g_form.getValue('course_date'); // Campo de data

    // Verifica se ambos os campos estão preenchidos
    if (!courseName || !courseDate) {
        return; // Não faz nada se algum dos campos não foi preenchido
    }

    // Chama o GlideAjax para validar a duplicidade
    var ga = new GlideAjax('ValidateUniqueCourseAndDate');
    ga.addParam('sysparm_name', 'isDuplicateAjax'); // Método público
    ga.addParam('sysparm_courseName', courseName);
    ga.addParam('sysparm_courseDate', courseDate);

    ga.getXMLAnswer(function(response) {
        var isDuplicate = response === 'true'; // Verifica se já existe um registro com os mesmos dados
        if (isDuplicate) {
            g_form.addErrorMessage('Já existe um registro com o mesmo Nome do Curso e Data.');
            g_form.setFieldError('course', 'Duplicado'); // Sinaliza erro no campo 'course'
            g_form.setFieldError('course_date', 'Duplicado'); // Sinaliza erro no campo 'course_date'
        } else {
            g_form.clearMessages(); // Limpa qualquer mensagem anterior
        }

        // Impede a submissão do formulário caso haja duplicidade
        if (isDuplicate) {
            g_form.setValue('course', oldValue); // Restaura o valor anterior se houver duplicidade
            g_form.setValue('course_date', oldValue); // Restaura o valor anterior da data
            return false; // Bloqueia a criação do registro
        }
    });
}]]></script>
