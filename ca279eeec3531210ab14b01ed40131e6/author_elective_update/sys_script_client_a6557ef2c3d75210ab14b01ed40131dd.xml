        <name>validation date</name>
        <order/>
        <script><![CDATA[function onSubmit() {
    var course = g_form.getValue('course'); // Obtém o valor do campo "course"
    var courseDate = g_form.getValue('course_date'); // Obtém o valor do campo "course_date"

    var gr = new GlideRecord('x_1593182_course_0_course_schedule'); 
    gr.addQuery('course', course); // Verifica o mesmo curso
    gr.addQuery('course_date', courseDate); // Verifica a mesma data
    gr.query();

    // Se encontrar duplicatas, bloqueia a operação
    if (gr.hasNext()) {
        g_form.showFieldMsg('course_date', 'Já existe um treinamento agendado para este curso nesta data.', 'error');
        return false; // Impede o envio do formulário
    }

    return true; // Permite a operação
}]]></script>
