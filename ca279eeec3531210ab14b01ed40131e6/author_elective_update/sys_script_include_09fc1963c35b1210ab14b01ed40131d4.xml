        <api_name>x_1593182_course_0.GetAvailableCourseDates</api_name>
        <caller_access/>
        <client_callable>false</client_callable>
        <description/>
        <mobile_callable>false</mobile_callable>
        <name>GetAvailableCourseDates</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var GetAvailableCourseDates = Class.create();
GetAvailableCourseDates.prototype = {
    initialize: function() {},

    refQualCourseDates: function(courseSysId) {
        var availableDates = [];
        var today = new GlideDate();
        today.addDaysUTC(1); // Somente datas futuras

        var gr = new GlideRecord("x_1593182_course_0_course_schedule");
        gr.addQuery("course", courseSysId); // Filtra pelo sys_id do curso
        gr.addQuery("course_date", ">=", today); // Somente datas futuras
        gr.orderBy("course_date"); // Ordena em ordem crescente
        gr.query();

        // Adicionando somente as datas no filtro
        while (gr.next()) {
            availableDates.push(gr.course_date.toString()); // Apenas a data do curso
        }

        return "course_dateIN" + availableDates.join(","); // Retorna somente os sys_ids das datas de curso
    },

    type: 'GetAvailableCourseDates'
};]]></script>
