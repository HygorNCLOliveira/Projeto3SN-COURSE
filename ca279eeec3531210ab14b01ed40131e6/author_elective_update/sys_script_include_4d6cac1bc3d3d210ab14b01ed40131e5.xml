        <name>CheckTrainingAvailability</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CheckTrainingAvailability = Class.create();
CheckTrainingAvailability.prototype = {
    initialize: function() {},

    checkAvailability: function(course, courseDate) {
        var gr = new GlideRecord('x_1593182_course_0_course_schedule');
        gr.addQuery('course', course);
        gr.addQuery('course_date', courseDate);
        gr.query();

        if (gr.next()) {
            return JSON.stringify({ available: false, message: "Já existe um treinamento agendado para este curso nesta data." });
        }
        return JSON.stringify({ available: true });
    },

    type: 'CheckTrainingAvailability'
};]]></script>
