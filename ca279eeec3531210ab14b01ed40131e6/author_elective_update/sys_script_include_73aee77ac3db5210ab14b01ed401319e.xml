        <description/>
        <mobile_callable>false</mobile_callable>
        <name>CourseChecker </name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var CourseChecker = Class.create();
CourseChecker.prototype = {
    initialize: function() {},
    
    checkCourse: function(courseName, courseDate) {
        var gr = new GlideRecord('x_1593182_course_0_course_schedule');
        gr.addQuery('course', courseName);
        gr.addQuery('course_date', courseDate);
        gr.query();
        
        if (gr.hasNext()) {
            return true; // Já existe um agendamento
        }
        return false; // Não existe duplicidade
    }
};

// Torna o Script Include acessível ao cliente
CourseChecker.prototype.clientCallable = true;]]></script>
