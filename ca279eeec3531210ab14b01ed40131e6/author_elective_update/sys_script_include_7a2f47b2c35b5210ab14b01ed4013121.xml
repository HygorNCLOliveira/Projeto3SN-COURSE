        <script><![CDATA[var ValidateUniqueCourseAndDate = Class.create();
ValidateUniqueCourseAndDate.prototype = {
    initialize: function() {},

    isDuplicate: function(courseName, courseDate) {
        var gr = new GlideRecord('x_1593182_course_0_course_schedule'); // Substitua pelo nome da tabela
        gr.addQuery('course', courseName); // Substitua 'course' pelo campo do nome do curso
        gr.addQuery('course_date', courseDate); // Substitua 'course_date' pelo campo da data
        gr.query();
        return gr.hasNext(); // Retorna true se houver duplicata
    },

    // Método público para GlideAjax
    isDuplicateAjax: function() {
        var courseName = this.getParameter('sysparm_courseName');
        var courseDate = this.getParameter('sysparm_courseDate');
        return this.isDuplicate(courseName, courseDate);
    },

    type: 'ValidateUniqueCourseAndDate'
};]]></script>
