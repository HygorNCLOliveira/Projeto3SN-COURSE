        <name>SearchCourseDate</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var SearchCourseDate = Class.create();
SearchCourseDate.prototype = Object.extendsObject(AbstractAjaxProcessor, {
    getDatesForCourseByName: function() {
        var courseName = this.getParameter('sysparm_course_name'); // Obtém o nome do curso
        var courseId = '';

        // Consulta a tabela de cursos para encontrar o ID pelo nome
        var grCourse = new GlideRecord('x_1593182_course_0_course_schedule'); // Substitua pelo nome correto da tabela de cursos
        grCourse.addQuery('course', courseName);
        grCourse.query();

        // Agora busca as datas usando o ID encontrado
        var dates = [];
        var grDates = new GlideRecord('x_1593182_course_0_course_schedule'); // Substitua pelo nome correto da tabela de datas
        grDates.addQuery('course', courseId);
        grDates.query();
        
        while (grDates.next()) {
            dates.push({
                value: grDates.getUniqueValue(),
                label: grDates.getValue('data')
            });
        }

        return JSON.stringify(dates);
    }
});]]></script>
