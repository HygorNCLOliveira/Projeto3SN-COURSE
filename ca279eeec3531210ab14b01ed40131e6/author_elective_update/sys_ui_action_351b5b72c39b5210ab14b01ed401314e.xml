        <script><![CDATA[(function executeAction() {
    // Obter valores dos campos de curso e data
    var courseName = g_form.getValue('course'); // Nome do curso
    var courseDate = g_form.getValue('course_date'); // Data do curso

    // Verifica se os campos de curso e data estão preenchidos
    if (!courseName || !courseDate) {
        g_form.addErrorMessage('Por favor, preencha todos os campos obrigatórios.');
        return false; // Bloqueia o envio do formulário se os campos estiverem vazios
    }

    // Chama o Script Include via GlideAjax
    var ga = new GlideAjax('CourseChecker'); // Nome do Script Include
    ga.addParam('sys_id', 'checkCourse'); // Nome do método
    ga.addParam('courseName', courseName); // Passa o valor de courseName
    ga.addParam('courseDate', courseDate); // Passa o valor de courseDate
    ga.getXMLAnswer(function(response) {
        var result = response.responseXML.documentElement.getAttribute('answer');
        
        if (result == 'true') {
            g_form.addErrorMessage('Já existe um treinamento agendado para este curso nesta data.');
            return false;
        }

        g_form.submit(); // Submete o formulário
        return true;
    });

    return false; // Impede o envio imediato até a resposta
})();]]></script>
