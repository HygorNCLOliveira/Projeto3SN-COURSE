        <name>Validate Course Registration</name>
        <order/>
        <published_ref/>
        <script><![CDATA[function onLoad() {
    waitForValues();
}

function waitForValues() {
    var courseSysId = g_form.getValue('course');
    var courseScheduleSysId = g_form.getValue('sys_id'); // ID da agenda do curso
    var userSysId = g_user.userID;
	setTimeout(waitForValues, 500);
}

function validateEnrollment(userSysId, courseSysId, courseScheduleSysId) {
    var ga = new GlideAjax('CourseUtils');
    ga.addParam('sysparm_name', 'validateEnrollment');
    ga.addParam('user_sys_id', userSysId);
    ga.addParam('sys_id', courseSysId);
    ga.addParam('course_schedule_sys_id', courseScheduleSysId);

    ga.getXMLAnswer(function(response) {
		
        if (response !== "OK") {
            g_form.setReadonly('course', true);
            g_form.setReadonly('course_date', true);
            g_form.showFieldMsg('course', response, 'error');
        }
    });
}]]></script>
