        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    var course = current.course; // Curso
    var course_date = current.course_date; // Data do treinamento

    // Verifica se já existe um agendamento para o mesmo curso e data
    var gr = new GlideRecord('x_1593182_course_0_course_schedule');
    gr.addQuery('course', course);
    gr.addQuery('course_date', course_date);
    gr.query();

    if (gr.next()) {
        // Se já existir, impede a inserção ou atualização e envia uma mensagem de erro
        gs.addErrorMessage('Já existe um treinamento agendado para essa data.');
        current.setAbortAction(true);  // Impede o salvamento do registro
    }
})(current, previous);]]></script>
